{
  "info": {
    "name": "RHConnect API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:8080/api" },
    { "key": "token",          "value": "" },
    { "key": "login_email",    "value": "" },
    { "key": "login_password", "value": "" }
  ],
  "item": [

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login valide → 200 + token",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse contient un token JWT', () => {",
            "  var json = pm.response.json();",
            "  pm.expect(json).to.have.property('token');",
            "  pm.collectionVariables.set('token', json.token);",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{login_email}}\",\n  \"motDePasse\": \"{{login_password}}\"\n}" }
          }
        },
        {
          "name": "Login invalide → 401 Unauthorized",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
            "pm.test('Aucun token retourné', () => {",
            "  pm.expect(pm.response.json()).to.not.have.property('token');",
            "});"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"inconnu@ism.edu.sn\",\n  \"motDePasse\": \"mauvais_mdp\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Admin IT",
      "item": [
        {
          "name": "Lister utilisateurs → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/admin/utilisateurs"
          }
        },
        {
          "name": "Accès sans token → 401 (RBAC)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Accès refusé sans token (401 ou 403)', () => {",
            "  pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
            "});"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/admin/utilisateurs"
          }
        }
      ]
    },

    {
      "name": "Vacataires",
      "item": [
        {
          "name": "Lister vacataires → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/vacataires"
          }
        }
      ]
    },

    {
      "name": "Contrats",
      "item": [
        {
          "name": "Lister contrats → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/contrats"
          }
        }
      ]
    },

    {
      "name": "Relevés d'heures",
      "item": [
        {
          "name": "Lister relevés → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/releves"
          }
        },
        {
          "name": "Doublon relevé → 409 Conflict",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Doublon détecté (409 Conflict)', () => pm.response.to.have.status(409));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/releves",
            "body": { "mode": "raw", "raw": "{\n  \"contratId\": 1,\n  \"periode\": \"2026-06\"\n}" }
          }
        }
      ]
    },

    {
      "name": "Paiements",
      "item": [
        {
          "name": "Lister paiements → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/paiements"
          }
        }
      ]
    },

    {
      "name": "Notifications",
      "item": [
        {
          "name": "Lister notifications → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Réponse est un tableau', () => { pm.expect(pm.response.json()).to.be.an('array'); });"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/notifications"
          }
        }
      ]
    },

    {
      "name": "Dashboard KPI",
      "item": [
        {
          "name": "KPI général → 200",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/dashboard/kpi"
          }
        }
      ]
    }

  ]
}
